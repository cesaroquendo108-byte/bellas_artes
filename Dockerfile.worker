FROM node:24-bookworm-slim

WORKDIR /app

# The worker runs TypeScript through the repository's tsx entrypoint. Keep
# devDependencies in this image because tsx is a runtime dependency here.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ENV NODE_ENV=production
ENV RUN_GENERATION_WORKER=true
ENV NODE_EXTRA_CA_CERTS=/app/infra/vast/jvastai_root_ca.pem

HEALTHCHECK --interval=30s --timeout=15s --start-period=20s --retries=3 CMD ["npm", "run", "worker:health"]
USER node

CMD ["npm", "run", "worker"]
