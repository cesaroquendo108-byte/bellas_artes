# Supabase público: puede utilizarse en el navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Exclusivo del servidor. Nunca use aquí la clave pública.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 privado.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_SANDBOX_BUCKET=

# Fase 5: se mantiene deshabilitado hasta aprobar un proveedor real.
AUDIO_PROVIDER=disabled
AUDIO_PROVIDER_API_KEY=
AUDIO_PROVIDER_WEBHOOK_SECRET=

# Protege la tarea programada que elimina objetos vencidos de R2.
CRON_SECRET=

# Extracción estructurada de comprobantes en el servidor.
OPENROUTER_API_KEY=
PAYMENT_VISION_MODEL=google/gemini-2.5-flash
FINVE_MCP_API_URL=https://api.finve.net/mcp
FINVE_MCP_API_KEY=

# URL pública del servidor MCP. Déjela vacía mientras la integración no esté desplegada.
NEXT_PUBLIC_MCP_SERVER_URL=
# El servidor MCP usa una API key de servicio y un usuario Bellas Artes acotado.
# No se expone en el navegador ni se comparte con el cliente MCP.
MCP_API_KEY=
MCP_USER_ID=
MCP_ALLOWED_ORIGIN=
MCP_PORT=8787

# Origen canónico para sitemap, Open Graph y metadata.
NEXT_PUBLIC_SITE_URL=https://bellasartes-xi.vercel.app

# Generación open source. Mantener deshabilitada hasta validar GPU y workflows.
GENERATION_ENABLED=false
GENERATION_ADMIN_ONLY=true
# Gates progresivos: admin -> allowlist -> public. El valor explícito prevalece
# sobre GENERATION_ADMIN_ONLY, que se conserva por compatibilidad.
GENERATION_ACCESS_MODE=admin
GENERATION_BILLING_MODE=shadow
GENERATION_AUDIT_ENABLED=false
GENERATION_REQUIRE_AUDIT=false
MODERATION_AUDIT_SALT=
GENERATION_RATE_LIMIT_ENABLED=false
GENERATION_RATE_LIMIT_WINDOW_SECONDS=3600
GENERATION_RATE_LIMIT_MAX=10
GENERATION_MODERATION_LEVEL=l1
GENERATION_MODERATION_PROVIDER=
GENERATION_MODERATION_MODEL=
GENERATION_REQUIRE_PROVENANCE=false
PROVENANCE_SIGNING_KEY=
GENERATION_PROVIDER=vast
GENERATION_MAX_ATTEMPTS=3
WORKER_CONCURRENCY=1
WORKER_QUEUE_KINDS=image,video,audio,character,world
VAST_QUEUE_THRESHOLD=50
VAST_SERVERLESS_MIN_LOAD=0
VAST_SERVERLESS_COLD_WORKERS=0
VAST_SERVERLESS_MAX_WORKERS=1
VAST_SERVERLESS_INACTIVITY_TIMEOUT_SECONDS=600
VAST_DEBUG_IDLE_SHUTDOWN_MINUTES=10
VAST_TEST_BUDGET_USD=0
VAST_TEST_MAX_JOBS=0
VAST_TEST_MAX_ESTIMATED_JOB_USD=0
VAST_TEST_MODALITY=
VAST_TEST_RUN_ID=
VAST_TEST_SESSION_ID=
VAST_TEST_SESSION_BUDGET_USD=0
VAST_TEST_RESERVE_USD=0.40
VAST_REQUEST_TIMEOUT_MS=15000
GENERATION_JOB_TIMEOUT_SECONDS=600
VAST_ESTIMATED_USD_PER_GPU_SECOND=0
VAST_IMAGE_ESTIMATED_USD_PER_GPU_SECOND=
VAST_AUDIO_ESTIMATED_USD_PER_GPU_SECOND=
VAST_VIDEO_ESTIMATED_USD_PER_GPU_SECOND=
VAST_CHARACTER_ESTIMATED_USD_PER_GPU_SECOND=
VAST_WORLD_ESTIMATED_USD_PER_GPU_SECOND=
REDIS_URL=
BULLMQ_PREFIX=bellas-artes
# Vercel usa este gateway HTTPS; Redis permanece privado dentro del VPS.
QUEUE_GATEWAY_URL=
QUEUE_GATEWAY_HMAC_KEY=
QUEUE_GATEWAY_PORT=8787
GENERATION_WORKER_TOKEN=
GENERATION_BLOCKED_TERMS=
VAST_COMFY_BASE_URL=
VAST_COMFY_API_KEY=
VAST_API_KEY=
VAST_SERVERLESS_ENDPOINT=
VAST_IMAGE_SERVERLESS_ENDPOINT=
VAST_AUDIO_SERVERLESS_ENDPOINT=
VAST_VIDEO_SERVERLESS_ENDPOINT=
VAST_CHARACTER_SERVERLESS_ENDPOINT=
VAST_WORLD_SERVERLESS_ENDPOINT=
VAST_LIVEPORTRAIT_SERVERLESS_ENDPOINT=
VAST_SERVERLESS_ROUTE_URL=https://run.vast.ai/route/
VAST_SERVERLESS_REQUEST_COST=100
VAST_IMAGE_REQUEST_COST=100
VAST_AUDIO_REQUEST_COST=100
VAST_VIDEO_REQUEST_COST=100
VAST_CHARACTER_REQUEST_COST=100
VAST_WORLD_REQUEST_COST=100
VAST_IMAGE_COMFY_BASE_URL=
