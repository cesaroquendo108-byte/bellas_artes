# Consola administrativa de alquiler Vast.ai. Las claves deben ser dedicadas,
# restringidas y distintas de la credencial de generación Serverless.
VAST_ADMIN_ENABLED=false
VAST_ADMIN_API_KEY=
VAST_LIFECYCLE_API_KEY=
VAST_ADMIN_OPERATOR_EMAIL=cesaroquendo10@gmail.com
VAST_ADMIN_COMFY_TEMPLATE_HASH=
VAST_ADMIN_FLUX_VOLUME_ID=
VAST_ADMIN_FLUX_MACHINE_ID=
VAST_ADMIN_FLUX_MOUNT_PATH=/workspace/ComfyUI/models/checkpoints
