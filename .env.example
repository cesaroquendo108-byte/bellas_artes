# Supabase público: puede utilizarse en el navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Exclusivo del servidor. Nunca use aquí la clave pública.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 privado.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=

# Fase 5: se mantiene deshabilitado hasta aprobar un proveedor real.
AUDIO_PROVIDER=disabled
AUDIO_PROVIDER_API_KEY=
AUDIO_PROVIDER_WEBHOOK_SECRET=

# Protege la tarea programada que elimina objetos vencidos de R2.
CRON_SECRET=

# Extracción estructurada de comprobantes en el servidor.
OPENROUTER_API_KEY=
PAYMENT_VISION_MODEL=google/gemini-2.5-flash
