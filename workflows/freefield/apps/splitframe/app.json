{
  "$schema": "../../schema/app.schema.json",
  "id": "splitframe",
  "name": "SplitFrame AI Crew Studio",
  "section": "video",
  "pack": "splitframe-ltx-crew",
  "status": "ready",
  "higgsfield_feature": "AI Desktop Video Editor / Multi-Agent Crew",
  "summary": "Editor de video asistido por equipo de IA (Director, Editor, Colourist, Audio) con generación LTX-Video 2.5 y mezcla de audio ACE-Step directo al timeline.",
  "workflow": "workflow.api.json",
  "source": {
    "template": "splitframe_ltx_crew.api.json",
    "comfyui": "0.42.0",
    "repository": "https://github.com/IronManRox228228/splitframe"
  },
  "outputs": [
    {
      "node": "10",
      "type": "video",
      "label": "SplitFrame Rendered Shot"
    }
  ],
  "inputs": [
    {
      "id": "prompt",
      "type": "textarea",
      "label": "Director's Shot Prompt",
      "required": true,
      "default": "Cinematic vertical shot, smooth camera movement, crisp financial charts in background, 4k photorealistic",
      "help": "Instrucción de toma generada por el agente Director de SplitFrame",
      "bind": [
        {
          "node": "3",
          "field": "prompt"
        }
      ]
    },
    {
      "id": "duration",
      "type": "slider",
      "label": "Shot Duration (Seconds)",
      "default": 4,
      "min": 1,
      "max": 10,
      "step": 0.5,
      "bind": [
        {
          "node": "4",
          "field": "duration_seconds"
        }
      ]
    },
    {
      "id": "pacing",
      "type": "select",
      "label": "Editor Pacing",
      "default": "commercial-punchy",
      "options": [
        {
          "value": "fast-paced",
          "label": "Fast Paced (Cortes Rápidos <3s)"
        },
        {
          "value": "commercial-punchy",
          "label": "Commercial Punchy (Equilibrado 3-4s)"
        },
        {
          "value": "cinematic-slow",
          "label": "Cinematic Slow (Tomas Largas >5s)"
        }
      ],
      "bind": [
        {
          "node": "5",
          "field": "pacing"
        }
      ]
    },
    {
      "id": "aspect_ratio",
      "type": "select",
      "label": "Aspect Ratio",
      "default": "9:16 (Vertical)",
      "options": [
        {
          "value": "9:16 (Vertical)",
          "label": "9:16 (Reels/TikTok/Shorts)"
        },
        {
          "value": "16:9 (Widescreen)",
          "label": "16:9 (Horizontal Cine)"
        },
        {
          "value": "1:1 (Square)",
          "label": "1:1 (Cuadrado)"
        }
      ],
      "bind": [
        {
          "node": "4",
          "field": "aspect_ratio"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "bind": [
        {
          "node": "6",
          "field": "seed"
        }
      ]
    }
  ]
}
